[Unit]
Description=Cloudflare Tunnel for hectorr.dev
After=network-online.target hector-personal-site.service

[Service]
Type=simple
ExecStart=/home/hector/.local/bin/cloudflared --no-autoupdate --config /home/hector/.config/hector-personal-site/tunnel.yml tunnel run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
